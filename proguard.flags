# Keep all Fragments in this package, which are used by reflection.
-keep class org.yozakuraos.yozakuraparts.*Fragment
-keep class org.yozakuraos.yozakuraparts.*Picker
-keep class org.yozakuraos.yozakuraparts.*Settings

-keep class org.yozakuraos.yozakuraparts.contributors.*
-keep class org.yozakuraos.yozakuraparts.gestures.*
-keep class org.yozakuraos.yozakuraparts.hardware.*
-keep class org.yozakuraos.yozakuraparts.input.*
-keep class org.yozakuraos.yozakuraparts.lineagestats.*
-keep class org.yozakuraos.yozakuraparts.livedisplay.*
-keep class org.yozakuraos.yozakuraparts.notificationlight.*
-keep class org.yozakuraos.yozakuraparts.power.*
-keep class org.yozakuraos.yozakuraparts.privacyguard.*
-keep class org.yozakuraos.yozakuraparts.profiles.*
-keep class org.yozakuraos.yozakuraparts.sounds.*

# Keep keyhandler constructor
-keep public class * implements com.android.internal.os.DeviceKeyHandler {
   public <init>(android.content.Context);
}

# Keep click responders
-keepclassmembers class com.android.settings.inputmethod.UserDictionaryAddWordActivity {
  *** onClick*(...);
}

# Keep remote preference updater
-keep public class * extends lineageos.preference.RemotePreferenceUpdater {
    *** fillResultExtras(...);
}

-keep public class * extends androidx.preference.* {
    public <init>(android.content.Context, android.util.AttributeSet);
}

# Keep specific fields used via reflection.
-keepclassmembers class * {
    public static ** SEARCH_INDEX_DATA_PROVIDER;
    public static ** SUMMARY_PROVIDER;
}
