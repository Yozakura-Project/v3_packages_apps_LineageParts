<!--
     SPDX-FileCopyrightText: The YozakuraOS Project
     SPDX-License-Identifier: Apache-2.0

     YozakuraOS cp113: status bar logo settings page. The logo itself was ported in cp112
     (SystemUI com.android.systemui.infinity.logo), gated by Settings.System status_bar_logo
     (default off).

     Everything here persists to android Settings.System via the bare (non-"Lineage")
     lineageos.preference widgets and the in-tree SystemSettingListPreference, matching the
     exact keys LogoImage observes. Do NOT use the Lineage* variants: those write to the
     separate LineageSettings provider, which LogoImage does not read.

     The custom colour picker is persistent="false" and is driven by YozakuraLogoFragment,
     which converts the RRGGBB hex it emits into the opaque ARGB int LogoImage expects.
-->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="yozakura_logo"
    android:title="@string/yozakura_logo_title">

    <lineageos.preference.SystemSettingMainSwitchPreference
        android:key="status_bar_logo"
        android:title="@string/yozakura_logo_switch_title"
        android:defaultValue="false" />

    <org.yozakuraos.yozakuraparts.preference.SystemSettingListPreference
        android:key="status_bar_logo_style"
        android:title="@string/yozakura_logo_style_title"
        android:entries="@array/yozakura_logo_style_entries"
        android:entryValues="@array/yozakura_logo_style_values"
        android:defaultValue="0"
        android:dependency="status_bar_logo" />

    <org.yozakuraos.yozakuraparts.preference.SystemSettingListPreference
        android:key="status_bar_logo_position"
        android:title="@string/yozakura_logo_position_title"
        android:entries="@array/yozakura_logo_position_entries"
        android:entryValues="@array/yozakura_logo_position_values"
        android:defaultValue="0"
        android:dependency="status_bar_logo" />

    <org.yozakuraos.yozakuraparts.preference.SystemSettingListPreference
        android:key="status_bar_logo_color"
        android:title="@string/yozakura_logo_color_title"
        android:entries="@array/yozakura_logo_color_entries"
        android:entryValues="@array/yozakura_logo_color_values"
        android:defaultValue="0"
        android:dependency="status_bar_logo" />

    <org.yozakuraos.yozakuraparts.yozakura.MonetColorPickerPreference
        android:key="status_bar_logo_custom_color"
        android:persistent="false"
        android:title="@string/yozakura_logo_custom_color_title"
        android:summary="@string/yozakura_logo_custom_color_summary"
        android:dependency="status_bar_logo" />

    <Preference
        android:key="yozakura_logo_footer"
        android:selectable="false"
        android:summary="@string/yozakura_logo_footer" />

</PreferenceScreen>
