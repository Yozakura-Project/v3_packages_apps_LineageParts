     SPDX-License-Identifier: Apache-2.0

     A brand strip, not a hero. The full-bleed sakura card took the top 40% of
     the viewport and did nothing; this keeps the branding at a height that lets
     the whole bento sheet fit on one screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="15dp"
    android:layout_marginEnd="15dp"
    android:background="@drawable/yozakura_banner_rounded"
    android:clipToOutline="true">

    <!-- The height lives here, not on the root: SettingsLib's LayoutPreference
         re-parents the inflated view with its own LayoutParams and drops the
         root's layout_height, so the root would fall back to wrap_content and
         this ImageView would render at the banner's intrinsic aspect (measured
         342dp instead of 76dp). -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:scaleType="centerCrop"
        android:src="@drawable/yozakura_banner_bg"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@drawable/yozakura_header_overlay" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/yozakura_header_title"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:shadowColor="#CC000000"
            android:shadowRadius="8"
            android:shadowDy="2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/yozakura_header_subtitle"
            android:textColor="#FCE4EC"
            android:textSize="12sp"
            android:shadowColor="#CC000000"
            android:shadowRadius="6"
            android:shadowDy="1" />
    </LinearLayout>
</FrameLayout>
